# Copiá este archivo como .env si necesitás cambiar algún valor (RNF-06).
# Si no existe .env, se usan estos mismos valores por defecto.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=m2_clientes_db
MONGO_TIMEOUT_MS=2000

# Claves públicas de M1 para validar la firma del token (hoy, el Keycloak local)
JWKS_URL=http://localhost:8080/realms/ds-2026-realm/protocol/openid-connect/certs
# Emisor esperado del token. Vacío = no se verifica, hasta que M1 lo defina (issue #9)
JWT_ISSUER=

# Orígenes del front que pueden llamar a la API, separados por coma
CORS_ORIGINS=http://localhost:5173
