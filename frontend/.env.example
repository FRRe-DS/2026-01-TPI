# Copiá este archivo como .env si necesitás cambiar algún valor.
# Si no existe .env, se usan estos mismos valores por defecto.
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ds-2026-realm
VITE_KEYCLOAK_CLIENT_ID=m2-frontend
# Scopes que se piden al iniciar sesión. Vacío = ninguno extra (sirve para el Keycloak local de hoy).
# Con un realm que tenga los scopes de M2 (por ejemplo, el de desarrollo del Grupo 17):
# VITE_KEYCLOAK_SCOPE=clientes:read clientes:write clientes.estado:read
VITE_KEYCLOAK_SCOPE=
