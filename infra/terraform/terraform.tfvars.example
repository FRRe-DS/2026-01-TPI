# Copiar como terraform.tfvars (que está en .gitignore) y completar tus datos:
#   cp terraform.tfvars.example terraform.tfvars

subscription_id = "00000000-0000-0000-0000-000000000000"
grupo           = "g01"
region          = "brazilsouth"

# Imágenes en GHCR
m2_api_image   = "ghcr.io/frre-ds/2026-01-tpi-api:desarrollo-m2"
m2_front_image = "ghcr.io/frre-ds/2026-01-tpi-front:desarrollo-m2"
m6_image       = "ghcr.io/frre-ds/m6-viajes-g12:sha-37db0f6"
m6_puerto      = 3006

# Escalado de réplicas de M2 API (cambiar m2_max_replicas = 1 para medir sin réplicas, o 3-5 para auto-escalado)
m2_min_replicas = 1
m2_max_replicas = 3

# OpenTelemetry -> Grafana Cloud
otel_service_name           = "m2-clientes-grupo01"
otel_exporter_otlp_endpoint = "https://otlp-gateway-prod-sa-east-1.grafana.net/otlp"
otel_exporter_otlp_headers  = "Authorization=Basic REEMPLAZAR_CON_TOKEN_BASE64"
otel_resource_attributes    = "grupo=grupo01"
